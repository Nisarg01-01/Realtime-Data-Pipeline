# Database Configuration
DB_USER=user
DB_PASSWORD=password
DB_HOST=localhost
DB_PORT=5432
DB_NAME=ecommerce

# Kafka Configuration
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_TOPIC=ecommerce_events

# Google AI Configuration (for AI Business Analyst feature)
# Get your API key from: https://makersuite.google.com/app/apikey
# Note: Dashboard works without this - only AI Analyst requires it
GOOGLE_API_KEY=your_google_api_key_here

# Data Configuration
DATA_FILE_PATH=Data/2019-Oct.csv
DATA_ROWS_LIMIT=100000

# Streaming Configuration
PRODUCER_DELAY=0.01
DASHBOARD_REFRESH_INTERVAL=15000
